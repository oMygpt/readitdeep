# =============================================================================
# Read it DEEP - 环境变量配置
# =============================================================================
# 复制此文件为 .env 并填写实际值
# cp .env.example .env
# =============================================================================

# ==================== 应用配置 ====================
APP_NAME=Read it DEEP
DEBUG=false
# 必填：至少 16 位随机值（openssl rand -hex 32）。默认值/空值时后端拒绝启动（DEBUG=true 除外）
SECRET_KEY=
CORS_ORIGINS=*
# 是否允许普通用户在设置页自定义 LLM / MinerU 服务地址（托管部署保持 false；开启后仍拒绝内网地址）
ALLOW_USER_ENDPOINTS=false
# 是否开放自助注册（关闭后由管理员在后台建账号；第一个账号总能注册为管理员）
ALLOW_REGISTRATION=true

# ==================== 部署模式 ====================
# standalone（默认，本地账号）| linked（只用 PaperDaily 账号登录，见 docs/plans/paperdaily-connect-contract.md）
RID_MODE=standalone
# linked 模式必填：
# PUBLIC_BASE_URL=https://read.paperdaily.org
# PAPERDAILY_BASE_URL=https://paperdaily.org
# PAPERDAILY_CLIENT_SECRET=
# PAPERDAILY_WEB_URL=https://paperdaily.org
# PAPERDAILY_ADMIN_SUBJECTS=<主站 user_id，逗号分隔>
# PAPERDAILY_TOKEN_KEYS=v1:<base64 32 字节，openssl rand -base64 32>

# ==================== 数据库 ====================
# SQLite (本地开发): sqlite
# PostgreSQL (生产): postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite

# Supabase (可选)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ==================== LLM 配置 ====================
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen2.5-72b
# 多个等价端点可用逗号分隔填在 LLM_BASE_URL（自动轮询与故障转移）
# 透传给模型服务的额外参数（JSON），如 Qwen3 关闭思考输出：
# LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
LLM_EXTRA_BODY=
# 每个进程的并发上限：交互（划词分析/对话）与批量（翻译/自动分析）
LLM_CONCURRENCY_INTERACTIVE=8
LLM_CONCURRENCY_BATCH=2

# ==================== 翻译 LLM ====================
TRANSLATION_BASE_URL=
TRANSLATION_API_KEY=
TRANSLATION_MODEL=qwen2.5-72b

# ==================== Embedding ====================
# Provider: local | volcengine
EMBEDDING_PROVIDER=local
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3

# ==================== MinerU OCR ====================
MINERU_API_URL=https://mineru.net/api/v4
MINERU_API_KEY=

# ==================== 文件存储 ====================
# Type: local | s3
STORAGE_TYPE=local
STORAGE_PATH=./uploads

# S3/OSS (STORAGE_TYPE=s3 时使用)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=readitdeep
